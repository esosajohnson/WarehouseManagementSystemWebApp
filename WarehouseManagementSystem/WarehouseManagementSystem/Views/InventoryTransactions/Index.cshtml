@model IEnumerable<WarehouseManagementSystem.Models.InventoryTransaction>

@{
    ViewData["Title"] = "Inventory Transactions";
}

<div class="container">
    <div class="row pt-4 align-items-center">
        <div class="col">
            <h2 class="text-primary fw-semibold text-nowrap mb-3">@ViewData["Title"]</h2>
        </div>
        <div class="col-auto mb-2">
            <a asp-action="Create" class="btn btn-primary px-4 text-nowrap">
                <i class="bi bi-plus-circle me-1"></i> New Transaction
            </a>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-12">
            <p class="text-muted">View and manage inventory transactions. Add new transactions, edit existing ones, or delete them as needed.</p>
        </div>
    </div>
</div>

<div class="container px-1 mt-3">
    <div class="container px-1 mb-3">
        <form method="get" asp-action="Index">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">Type</label>
                    <select name="transactionType" class="form-select" asp-items="@(ViewData["TransactionTypeList"] as SelectList)">
                        <option value="">All Types</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">Product</label>
                    <select name="productId" class="form-select" asp-items="@(ViewData["ProductId"] as SelectList)">
                        <option value="">All Products</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">From</label>
                    <input type="date" name="dateFrom" class="form-control" value="@(ViewData["DateFrom"] ?? String.Empty)" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">To</label>
                    <input type="date" name="dateTo" class="form-control" value="@(ViewData["DateTo"] ?? String.Empty)" />
                </div>
                <div class="col-12 mt-2 d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            @{ var q = ViewContext.HttpContext.Request.Query; var hasFilters = !string.IsNullOrEmpty((string)q["transactionType"]) || !string.IsNullOrEmpty((string)q["productId"]) || !string.IsNullOrEmpty((string)q["dateFrom"]) || !string.IsNullOrEmpty((string)q["dateTo"]); }
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-arrow-counterclockwise display-1 text-muted"></i>
                    <h4 class="text-muted mt-3">No inventory transactions found.</h4>
                    @if (hasFilters)
                    {
                        <p class="text-muted">No inventory transactions match the current filters.</p>
                        <a asp-action="Index" class="btn btn-outline-secondary mt-3">Clear filters</a>
                    }
                    else
                    {
                        <p class="text-muted">Click the button above to add a transaction.</p>
                        <a asp-action="Create" class="btn btn-primary px-4 mt-3">
                            <i class="bi bi-plus-circle me-1"></i> New Transaction
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Product</th>
                                <th>Type</th>
                                <th>Quantity</th>
                                <th>Location</th>
                                <th>Employee</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-nowrap">@item.TransactionDate.ToString("yyyy-MM-dd")</td>
                                    <td class="text-nowrap">@item.Product?.Name</td>
                                    <td>@item.TransactionType</td>
                                    <td>@item.QuantityChanged</td>
                                    <td class="text-nowrap">@item.Location?.Name</td>
                                    <td class="text-nowrap">@(item.Employee != null ? item.Employee.FirstName + " " + item.Employee.LastName : "-")</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.TransactionId" class="btn btn-outline-secondary btn-sm">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.TransactionId" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-eye-fill"></i> Details
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.TransactionId" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash-fill"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
