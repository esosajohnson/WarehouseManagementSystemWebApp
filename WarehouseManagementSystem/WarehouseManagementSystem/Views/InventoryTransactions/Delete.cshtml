@model WarehouseManagementSystem.Models.InventoryTransaction

@{
    ViewData["Title"] = "Delete Inventory Transaction";
}

<div class="alert alert-danger mx-auto" role="alert" style="max-width: 700px;">
    <i class="bi bi-exclamation-triangle-fill me-2"></i>
    This action cannot be undone. Deleting this transaction will permanently remove it from the system.
</div>

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4 p-4 mx-auto" style="max-width: 700px;">
        <h3 class="text-danger fw-semibold mb-4">Delete Inventory Transaction</h3>

        <div class="mb-3">
            <h5>Are you sure you want to delete this transaction?</h5>
        </div>

        <dl class="row">
            <dt class="col-sm-4">Transaction Date</dt>
            <dd class="col-sm-8">@Model.TransactionDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-4">Product</dt>
            <dd class="col-sm-8">@Model.Product?.Name</dd>

            <dt class="col-sm-4">Quantity</dt>
            <dd class="col-sm-8">@Model.QuantityChanged</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="TransactionId" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>
