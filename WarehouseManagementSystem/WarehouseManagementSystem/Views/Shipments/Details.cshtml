@model WarehouseManagementSystem.Models.Shipment

@{
    ViewData["Title"] = "Shipment Details";
}

<div class="container py-5">
    <div class="card shadow-sm p-4 border-0 rounded-4 mx-auto" style="max-width: 700px;">
        <h2 class="text-primary fw-semibold mb-4">Shipment Details</h2>
        <dl class="row">
            <dt class="col-sm-3">Tracking Number</dt>
            <dd class="col-sm-9">@(Model.TrackingNumber ?? "-")</dd>
            <dt class="col-sm-3">Carrier</dt>
            <dd class="col-sm-9">@(Model.Carrier ?? "-")</dd>
            <dt class="col-sm-3">Destination</dt>
            <dd class="col-sm-9">@(Model.Destination ?? "-")</dd>
            <dt class="col-sm-3">Shipping Date</dt>
            <dd class="col-sm-9">@Model.ShippingDate</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
            <dt class="col-sm-3">Employee</dt>
            <dd class="col-sm-9">@(Model.Employee?.FullName ?? "-")</dd>
            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@(Model.Notes ?? "-")</dd>
        </dl>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <a asp-action="Edit" asp-route-id="@Model.ShipmentId" class="btn btn-primary px-4">
                <i class="bi bi-pencil-square me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary px-4">
                <i class="bi bi-arrow-left-circle me-1"></i> Back to List
            </a>
            @if (Model.Status == ShipmentStatus.Pending)
            {
                <a asp-controller="ShipmentItems"
                   asp-action="Create"
                   asp-route-shipmentId="@Model.ShipmentId"
                   class="btn btn-primary ms-auto">
                    <i class="bi bi-plus-circle me-1"></i> Add Item
                </a>
            }
        </div>
    </div>
</div>

@if (Model.ShipmentItems != null && Model.ShipmentItems.Any())
{
    <div class="card shadow-sm border-0 rounded-4 mx-auto mt-4" style="max-width: 1000px;">
        <div class="card-body p-4">
            <h3 class="text-primary fw-semibold mb-4">Shipment Items</h3>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Location</th>
                            <th>Quantity Shipped</th>
                            <th>Unit Price</th>
                            <th>Line Total</th>
                            @if (Model.Status == ShipmentStatus.Pending)
                            {
                                <th>Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ShipmentItems)
                        {
                            <tr>
                                <td>@item.Product?.Name</td>
                                <td>@item.Location?.Name</td>
                                <td>@item.QuantityShipped</td>
                                <td>@(item.UnitPrice?.ToString("C2") ?? "—")</td>
                                <td>@(item.LineTotal?.ToString("C2") ?? "—")</td>
                                @if (Model.Status == ShipmentStatus.Pending)
                                {
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <a asp-controller="ShipmentItems"
                                               asp-action="Edit"
                                               asp-route-id="@item.ShipmentItemId"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                            <a asp-controller="ShipmentItems"
                                               asp-action="Delete"
                                               asp-route-id="@item.ShipmentItemId"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash-fill"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0 rounded-4 p-4 mx-auto mt-4" style="max-width: 1000px;">
        <div class="card-body text-center">
            <h5 class="text-muted">No items found for this shipment.</h5>
            <p class="text-muted">Use the "Add Item" button above to add items to this shipment.</p>
        </div>
    </div>
}