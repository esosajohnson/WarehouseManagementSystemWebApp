@model IEnumerable<WarehouseManagementSystem.Models.Shipment>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@{
    ViewData["Title"] = "Shipments";
}

<div class="container">
    <div class="row pt-4 align-items-center">
        <div class="col">
            <h2 class="text-primary fw-semibold text-nowrap mb-3">@ViewData["Title"]</h2>
        </div>
        <div class="col-auto mb-2">
            <a asp-action="Create" class="btn btn-primary px-4 text-nowrap">
                <i class="bi bi-plus-circle me-1"></i> Create New Shipment
            </a>
        </div>
    </div>
</div>

<div class="container mb-2">
    <div class="row">
        <div class="col-12">
            <p class="text-muted">Manage your shipments efficiently using the options below.</p>
        </div>
    </div>
</div>

<div class="container px-1 mb-3">
    <form method="get" asp-action="Index">
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label fw-semibold small text-muted">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="searchString" value="@ViewData["SearchString"]"
                           class="form-control" placeholder="Search by tracking number..." />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold small text-muted">Status</label>
                <select name="status" class="form-select" asp-items="@(ViewData["StatusList"] as SelectList)">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </div>
    </form>
</div>

<div class="container px-1">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            @{ var q = ViewContext.HttpContext.Request.Query; var hasFilters = !string.IsNullOrEmpty((string?)ViewData["SearchString"]) || !string.IsNullOrEmpty((string)q["status"]); }
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-box-seam display-4 text-muted mb-3"></i>
                    <h4 class="text-muted">No shipments found.</h4>
                    @if (hasFilters)
                    {
                        <p class="text-muted">No shipments match the current filters.</p>
                        <a asp-action="Index" class="btn btn-outline-secondary mt-3">Clear filters</a>
                    }
                    else
                    {
                        <p class="text-muted">Get started by creating a new shipment.</p>
                        <a asp-action="Create" class="btn btn-primary px-4">
                            <i class="bi bi-plus-circle me-1"></i> Create New Shipment
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Tracking Number</th>
                            <th scope="col">Carrier</th>
                            <th scope="col">Destination</th>
                            <th scope="col">Shipping Date</th>
                            <th scope="col">Status</th>
                            <th scope="col">Employee</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var shipment in Model)
                        {
                            <tr>
                                <td>@shipment.TrackingNumber</td>
                                <td>@shipment.Carrier</td>
                                <td>@shipment.Destination</td>
                                <td>@shipment.ShippingDate</td>
                                <td>
                                    @switch (shipment.Status)
                                    {
                                        case ShipmentStatus.Pending:
                                            <span class="badge bg-warning">
                                                <i class="bi bi-hour glass-split me-1"></i> Pending
                                            </span>
                                            break;
                                        case ShipmentStatus.Dispatched:
                                            <span class="badge bg-success">
                                                <i class="bi bi-truck me-1"></i> Dispatched
                                            </span>
                                            break;
                                        case ShipmentStatus.Delivered:
                                            <span class="badge bg-primary">
                                                <i class="bi bi-check-circle me-1"></i> Delivered
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-question-circle me-1"></i> Unknown
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>@shipment.Employee?.FullName</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@shipment.ShipmentId" class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@shipment.ShipmentId" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-eye-fill"></i> Details
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@shipment.ShipmentId" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash-fill"></i> Delete
                                        </a>
                                        <form asp-action="Dispatch" asp-route-id="@shipment.ShipmentId"
                                              method="post" class="m-0 p-0 d-flex">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm"
                                                @(shipment.Status == ShipmentStatus.Dispatched ? "disabled" : "")>
                                                <i class="bi bi-send-fill me-1"></i> Dispatch
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>