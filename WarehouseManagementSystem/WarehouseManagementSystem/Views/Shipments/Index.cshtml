@model IEnumerable<WarehouseManagementSystem.Models.Shipment>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@{
    ViewData["Title"] = "Shipments";
}

<div class="container">
    <div class="row pt-4 align-items-center">
        <div class="col">
            <h2 class="text-primary fw-semibold text-nowrap mb-3">@ViewData["Title"]</h2>
        </div>
        <div class="col-auto mb-2">
            <a asp-action="Create" class="btn btn-primary px-4 text-nowrap">
                <i class="bi bi-plus-circle me-1"></i> Create New Shipment
            </a>
        </div>
    </div>
</div>

<div class="container mb-2">
    <div class="row">
        <div class="col-12">
            <p class="text-muted">Manage your shipments efficiently using the options below.</p>
        </div>
    </div>
</div>

<div class="container px-1">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-box-seam display-4 text-muted mb-3"></i>
                    <h4 class="text-muted">No shipments found.</h4>
                    <p class="text-muted">Get started by creating a new shipment.</p>
                    <a asp-action="Create" class="btn btn-primary px-4">
                        <i class="bi bi-plus-circle me-1"></i> Create New Shipment
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Tracking Number</th>
                            <th scope="col">Carrier</th>
                            <th scope="col">Destination</th>
                            <th scope="col">Shipping Date</th>
                            <th scope="col">Status</th>
                            <th scope="col">Employee</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var shipment in Model)
                        {
                            <tr>
                                <td>@shipment.TrackingNumber</td>
                                <td>@shipment.Carrier</td>
                                <td>@shipment.Destination</td>
                                <td>@shipment.ShippingDate</td>
                                <td>
                                    @switch (shipment.Status)
                                    {
                                        case ShipmentStatus.Pending:
                                            <span class="badge bg-warning">
                                                <i class="bi bi-hour glass-split me-1"></i> Pending
                                            </span>
                                            break;
                                        case ShipmentStatus.Dispatched:
                                            <span class="badge bg-success">
                                                <i class="bi bi-truck me-1"></i> Dispatched
                                            </span>
                                            break;
                                        case ShipmentStatus.Delivered:
                                            <span class="badge bg-primary">
                                                <i class="bi bi-check-circle me-1"></i> Delivered
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-question-circle me-1"></i> Unknown
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>@shipment.Employee?.FullName</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <a asp-action="Details" asp-route-id="@shipment.ShipmentId"
                                           class="btn btn-outline-info btn-sm">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@shipment.ShipmentId"
                                           class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@shipment.ShipmentId"
                                           class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                        <form asp-action="Dispatch" asp-route-id="@shipment.ShipmentId"
                                              method="post" class="m-0 p-0 d-flex">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm"
                                                @(shipment.Status == ShipmentStatus.Dispatched ? "disabled" : "")>
                                                <i class="bi bi-send-fill me-1"></i> Dispatch
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>