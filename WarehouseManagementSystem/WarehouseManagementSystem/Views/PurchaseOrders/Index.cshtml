@using WarehouseManagementSystem.Models;
@model IEnumerable<WarehouseManagementSystem.Models.PurchaseOrder>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@{
    ViewData["Title"] = "Purchase Orders";
}

<div class="container">
    <div class="row pt-4 align-items-center">
        <div class="col">
            <h2 class="text-primary fw-semibold text-nowrap mb-3">@ViewData["Title"]</h2>
        </div>
        <div class="col-auto mb-2">
            <a asp-action="Create" class="btn btn-primary px-4 text-nowrap">
                <i class="bi bi-plus-circle me-1"></i> Create Purchase Order
            </a>
        </div>
    </div>
</div>

<div class="container mb-2">
    <div class="row">
        <div class="col-12">
            <p class="text-muted">Manage the purchase orders to view details and manage items.</p>
        </div>
    </div>
</div>

<div class="container px-1 mb-3">
    <form method="get" asp-action="Index">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-semibold small text-muted">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="searchString" value="@ViewData["SearchString"]"
                           class="form-control" placeholder="Search by PO number or supplier..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted">Supplier</label>
                <select name="supplierId" class="form-select" asp-items="@(ViewData["SupplierId"] as SelectList)">
                    <option value="">All Suppliers</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small text-muted">Status</label>
                <select name="status" class="form-select" asp-items="@(ViewData["StatusList"] as SelectList)">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </div>
    </form>
</div>

<div class="container px-1">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            @{ var q = ViewContext.HttpContext.Request.Query; var hasFilters = !string.IsNullOrEmpty((string?)ViewData["SearchString"]) || !string.IsNullOrEmpty((string)q["supplierId"]) || !string.IsNullOrEmpty((string)q["status"]); }
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-file-earmark-text display-4 text-muted mb-3"></i>
                    <h4 class="text-muted">No Purchase Orders Found</h4>
                    @if (hasFilters)
                    {
                        <p class="text-muted">No purchase orders match the current filters.</p>
                        <a asp-action="Index" class="btn btn-outline-secondary mt-3">Clear filters</a>
                    }
                    else
                    {
                        <p class="text-muted">Click the button above to create your first purchase order.</p>
                        <a asp-action="Create" class="btn btn-primary mt-3">
                            <i class="bi bi-plus-circle me-1"></i> Create Purchase Order
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Order Date</th>
                            <th>Expected Date</th>
                            <th>Status</th>
                            <th>Total Amount</th>
                            <th>Supplier</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.OrderDate.ToShortDateString()</td>
                                <td>@item.ExpectedDate?.ToShortDateString()</td>
                                <td>@item.OrderStatus</td>
                                <td>@item.TotalAmount.ToString("C")</td>
                                <td>@item.Supplier?.Name</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <a asp-action="Details" asp-route-id="@item.PurchaseOrderId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye-fill me-1"></i> View
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.PurchaseOrderId"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil-fill me-1"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.PurchaseOrderId"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash-fill me-1"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>