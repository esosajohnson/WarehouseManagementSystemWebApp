@model IEnumerable<WarehouseManagementSystem.Models.Category>

@if (TempData["ErrorMessage"] != null)
{
	<div class="alert alert-danger">
		@TempData["ErrorMessage"]
	</div>
}

@{
    ViewData["Title"] = "Categories";
}

<div class="container">
	<div class="row pt-4 align-items-center">
		<div class="col">
			<h2 class="text-primary fw-semibold text-nowrap mb-3">@ViewData["Title"]</h2>
		</div>
		<div class="col-auto mb-2">
			<a asp-action="Create" class="btn btn-primary px-4 text-nowrap">
				<i class="bi bi-plus-circle me-1"></i> Create New Category
			</a>
		</div>
	</div>
</div>

<div class="container mb-2">
	<div class="row">
		<div class="col-12">
			<p class="text-muted">Here you can manage your categories. You can create, edit, view details, or delete categories.</p>
		</div>
    </div>
</div>

<div class="container px-1">
	<div class="card shadow-sm border-0 rounded-4">
		<div class="card-body p-4">
			@if (!Model.Any())
			{
				<div class="text-center py-5">
					<i class="bi bi-folder display-4 text-muted mb-3"></i>
					<h4 class="text-muted">No categories found.</h4>
					<p class="text-muted">Get started by creating a new category.</p>
					<a asp-action="Create" class="btn btn-primary px-4">
                        <i class="bi bi-plus-circle me-1"></i> Create New Category
					</a>
				</div>
			}
			else
			{
				<div class="table-responsive">
					<table class="table table-hover align-middle">
					<thead class="table-light">
						<tr>
							<th>Category</th>
							<th>Description</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var entry in Model)
						{
							<tr>
								<td>@entry.Name</td>
								<td>@entry.Description</td>
								<td>
									<div class="d-flex align-items-center gap-2">
										<a asp-action="Edit" asp-route-id="@entry.CategoryId" class="btn btn-outline-secondary btn-sm">
											<i class="bi bi-pencil-square"></i> Edit
										</a>
										<a asp-action="Details" asp-route-id="@entry.CategoryId" class="btn btn-outline-primary btn-sm">
											<i class="bi bi-eye-fill"></i> Details
										</a>
										<a asp-action="Delete" asp-route-id="@entry.CategoryId" class="btn btn-outline-danger btn-sm">
											<i class="bi bi-trash-fill"></i> Delete
										</a>
									</div>
								</td>

							</tr>
						}
					</tbody>
					</table>
				</div>
			}
		</div>
	</div>
</div>