@model WarehouseManagementSystem.Models.StockLevel

<div class="alert alert-danger mx-auto" role="alert" style="max-width: 700px;"> 
    <i class="bi bi-exclamation-triangle-fill me-2"></i> 
    This action cannot be undone. Deleting this stock level will remove it from inventory records. 
</div>

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4 p-4 mx-auto" style="max-width: 700px;">
        <h3 class="text-primary fw-semibold mb-4">Delete Stock Level</h3>
        <h5 class="text-danger mb-3">Are you sure you want to delete this stock level?</h5>
        <dl class="row mb-0">
            <dt class="col-sm-4">Quantity on Hand</dt>
            <dd class="col-sm-8">@Model.QuantityOnHand</dd>

            <dt class="col-sm-4">Last Updated</dt>
            <dd class="col-sm-8">@Model.LastUpdated</dd>

            <dt class="col-sm-4">Location</dt>
            <dd class="col-sm-8">@Model.Location?.Name</dd>

            <dt class="col-sm-4">Product</dt>
            <dd class="col-sm-8">@Model.Product?.Name</dd>
        </dl>

        <form asp-action="Delete" class="mt-4">
            <input type="hidden" asp-for="StockLevelId" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i> Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">
                <i class="bi bi-x-circle me-1"></i> Cancel
            </a>
        </form>
    </div>
</div>
