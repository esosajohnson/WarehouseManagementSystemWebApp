@model IEnumerable<WarehouseManagementSystem.Models.StockLevel>

<div class="container">
    <div class="row pt-4 align-items-center">
        <div class="col">
            <h2 class="text-primary fw-semibold text-nowrap mb-3">Stock Levels</h2>
        </div>
        <div class="col-auto mb-2">
            <a asp-action="Create" class="btn btn-primary px-4 text-nowrap">
                <i class="bi bi-plus-circle me-1"></i> Create New Stock Level
            </a>
        </div>
    </div>
</div>

<div class="container mb-2">
    <div class="row">
        <div class="col-12">
            <p class="text-muted">Manage current stock levels. You can create, edit, view details, or delete stock level records.</p>
        </div>
    </div>
</div>

<div class="container px-1">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-box-seam display-1 text-muted"></i>
                    <h4 class="text-muted mt-3">No stock levels found.</h4>
                    <p class="text-muted">Click the button above to add your first stock level record.</p>
                    <a asp-action="Create" class="btn btn-primary px-4 mt-3 text-nowrap">
                        <i class="bi bi-plus-circle me-1"></i> Create New Stock Level
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Quantity On Hand</th>
                                <th>Last Updated</th>
                                <th>Location</th>
                                <th>Product</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.QuantityOnHand</td>
                                    <td>@item.LastUpdated</td>
                                    <td>@item.Location?.Name</td>
                                    <td>@item.Product?.Name</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <a asp-action="Details" asp-route-id="@item.StockLevelId"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye-fill me-1"></i> View
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.StockLevelId"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil-fill me-1"></i> Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.StockLevelId"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash-fill me-1"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
