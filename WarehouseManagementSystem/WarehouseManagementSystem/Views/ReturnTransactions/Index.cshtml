@model IEnumerable<WarehouseManagementSystem.Models.ReturnTransaction>

@{
    ViewData["Title"] = "Manage Return Transactions";
}

<div class="container">
    <div class="row pt-4 align-items-center">
        <div class="col">
            <h2 class="text-primary fw-semibold text-nowrap mb-3">@ViewData["Title"]</h2>
        </div>
        <div class="col-auto mb-2">
            <a asp-action="Create" class="btn btn-primary px-4 text-nowrap">
                <i class="bi bi-plus-circle me-1"></i> New Return
            </a>
        </div>
    </div>
</div>

<div class="container px-1 mt-3">
    <div class="container px-1 mb-3">
        <form method="get" asp-action="Index">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold small text-muted">Product</label>
                    <select name="productId" class="form-select" asp-items="@(ViewData["ProductId"] as SelectList)">
                        <option value="">All Products</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">Status</label>
                    <select name="status" class="form-select" asp-items="@(ViewData["StatusList"] as SelectList)">
                        <option value="">All Statuses</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">Processed By</label>
                    <select name="employeeId" class="form-select" asp-items="@(ViewData["EmployeeId"] as SelectList)">
                        <option value="">All Employees</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            @{ var q = ViewContext.HttpContext.Request.Query; var hasFilters = !string.IsNullOrEmpty((string)q["productId"]) || !string.IsNullOrEmpty((string)q["status"]) || !string.IsNullOrEmpty((string)q["employeeId"]); }
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-arrow-counterclockwise display-1 text-muted"></i>
                    <h4 class="text-muted mt-3">No return transactions found.</h4>
                    @if (hasFilters)
                    {
                        <p class="text-muted">No return transactions match the current filters.</p>
                        <a asp-action="Index" class="btn btn-outline-secondary mt-3">Clear filters</a>
                    }
                    else
                    {
                        <p class="text-muted">Click the button above to add a return transaction.</p>
                        <a asp-action="Create" class="btn btn-primary px-4 mt-3">
                            <i class="bi bi-plus-circle me-1"></i> New Return
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Return Date</th>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Condition</th>
                            <th>Processed By</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ReturnDate.ToString("yyyy-MM-dd")</td>
                                <td>@item.Product?.Name</td>
                                <td>@item.Quantity</td>
                                <td>
                                    @switch (item.ConditionStatus)
                                    {
                                        case ReturnStatus.Pending:
                                            <span class="badge-soft-warning">Pending</span>
                                            break;
                                        case ReturnStatus.Restocked:
                                            <span class="badge-soft-success">Restocked</span>
                                            break;
                                        case ReturnStatus.WrittenOff:
                                            <span class="badge-soft-danger">Written Off</span>
                                            break;
                                    }
                                </td>
                                <td>@(item.ProcessedByEmployee != null ? item.ProcessedByEmployee.FirstName + " " + item.ProcessedByEmployee.LastName : "-")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.ReturnTransactionId" class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.ReturnTransactionId" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-eye-fill"></i> Details
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ReturnTransactionId" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash-fill"></i> Delete
                                        </a>
                                        <form asp-action="Restock" asp-route-id="@item.ReturnTransactionId"
                                              method="post" class="m-0 p-0 d-flex">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm"
                                                @(item.ConditionStatus != ReturnStatus.Pending ? "disabled" : "")>
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> Restock
                                            </button>
                                        </form>
                                        <form asp-action="WriteOff" asp-route-id="@item.ReturnTransactionId"
                                              method="post" class="m-0 p-0 d-flex">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-warning btn-sm"
                                                @(item.ConditionStatus != ReturnStatus.Pending ? "disabled" : "")>
                                                <i class="bi bi-x-circle me-1"></i> Write Off
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
