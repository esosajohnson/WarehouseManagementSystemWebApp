@model WarehouseManagementSystem.Models.ReturnTransaction

@{
    ViewData["Title"] = "Delete Return Transaction";
}

<div class="container py-4">
    <div class="card shadow-sm border-0 rounded-4 p-4">
        <h3 class="mb-3">Delete Return</h3>
        <div class="mb-3">
            <label class="form-label">Are you sure you want to delete this return transaction?</label>
        </div>

        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <span>This action is permanent and cannot be undone.</span>
        </div>

        <dl class="row">
            <dt class="col-sm-3">Return Date</dt>
            <dd class="col-sm-9">@Model.ReturnDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Product</dt>
            <dd class="col-sm-9">@Model.Product?.Name</dd>

            <dt class="col-sm-3">Quantity</dt>
            <dd class="col-sm-9">@Model.Quantity</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="ReturnTransactionId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
