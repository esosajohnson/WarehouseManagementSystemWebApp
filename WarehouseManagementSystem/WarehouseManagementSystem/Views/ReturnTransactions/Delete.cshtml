@model WarehouseManagementSystem.Models.ReturnTransaction

@{
    ViewData["Title"] = "Delete Return Transaction";
}

<div class="alert alert-danger mx-auto" role="alert" style="max-width: 700px;">
    <i class="bi bi-exclamation-triangle-fill me-2"></i>
    This action cannot be undone. Deleting this return transaction will permanently remove it from the system.
</div>
<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4 p-4 mx-auto" style="max-width: 700px;">
        <h3 class="text-danger fw-bold mb-3">Delete Return</h3>
        <div class="mb-3">
            <label class="form-label text-dark">Are you sure you want to delete this return transaction?</label>
        </div>

        <dl class="row">
            <dt class="col-sm-3">Return Date</dt>
            <dd class="col-sm-9">@Model.ReturnDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Product</dt>
            <dd class="col-sm-9">@Model.Product?.Name</dd>

            <dt class="col-sm-3">Quantity</dt>
            <dd class="col-sm-9">@Model.Quantity</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="ReturnTransactionId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
