@model WarehouseManagementSystem.Models.ReturnTransaction

@{
    ViewData["Title"] = "Edit Return Transaction";
}

<div class="container py-5">
    <div class="card shadow-sm p-4 border-0 rounded-4 mx-auto" style="max-width: 900px;">
        <h2 class="text-primary fw-semibold mb-4">@ViewData["Title"]</h2>

        <form asp-action="Edit">
            <input type="hidden" asp-for="ReturnTransactionId" />
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ProductId" class="control-label fw-semibold">Product</label>
                <select asp-for="ProductId" class="form-select" asp-items="ViewBag.ProductId">
                    <option value="">Please select a product</option>
                </select>
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LocationId" class="control-label fw-semibold">Location</label>
                <select asp-for="LocationId" class="form-select" asp-items="ViewBag.LocationId">
                    <option value="">Please select a location</option>
                </select>
                <span asp-validation-for="LocationId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ShipmentId" class="control-label fw-semibold">Shipment</label>
                <select asp-for="ShipmentId" class="form-select" asp-items="ViewBag.ShipmentId">
                    <option value="">Please select a shipment</option>
                </select>
                <span asp-validation-for="ShipmentId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label fw-semibold"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ReturnReason" class="form-label fw-semibold"></label>
                <textarea asp-for="ReturnReason" class="form-control"></textarea>
                <span asp-validation-for="ReturnReason" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ReturnDate" class="form-label fw-semibold"></label>
                <input asp-for="ReturnDate" class="form-control" />
                <span asp-validation-for="ReturnDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ProcessedByEmployeeId" class="control-label fw-semibold">Processed By</label>
                <select asp-for="ProcessedByEmployeeId" class="form-select" asp-items="ViewBag.ProcessedByEmployeeId">
                    <option value="">Please select an employee</option>
                </select>
                <span asp-validation-for="ProcessedByEmployeeId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConditionStatus" class="form-label fw-semibold">Condition Status</label>
                <select asp-for="ConditionStatus" class="form-select">
                    @foreach (var status in Enum.GetValues(typeof(WarehouseManagementSystem.Models.ReturnStatus)))
                    {
                        <option value="@status">@status</option>
                    }
                </select>
                <span asp-validation-for="ConditionStatus" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label fw-semibold"></label>
                <textarea asp-for="Notes" class="form-control"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-save me-1"></i> Save
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
