@model WarehouseManagementSystem.Models.PurchaseOrderItem

@{
    ViewData["Title"] = "Purchase Order Item Details";
}

<div class="container py-5">
    <div class="card shadow-sm p-4 border-0 rounded-4 mx-auto" style="max-width: 800px;">
        <h2 class="text-primary fw-semibold mb-4">Purchase Order Item Details</h2>
        <dl class="row">
            <dt class="col-sm-4">Quantity</dt>
            <dd class="col-sm-8">@Model.Quantity</dd>
            <dt class="col-sm-4">Unit Cost</dt>
            <dd class="col-sm-8">@(Model.UnitCost.ToString("C2") ?? "—")</dd>
            <dt class="col-sm-4">Line Total</dt>
            <dd class="col-sm-8">@(Model.LineTotal.ToString("C2") ?? "—")</dd>
            <dt class="col-sm-4">Product</dt>
            <dd class="col-sm-8">@Model.Product?.Name</dd>
            <dt class="col-sm-4">Purchase Order</dt>
            <dd class="col-sm-8">@Model.PurchaseOrder?.PurchaseOrderId</dd>
        </dl>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.PurchaseOrderItemId" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary ms-2 px-4">
                <i class="bi bi-arrow-left-circle me-1"></i> Back to List
            </a>
        </div>
    </div>
</div>