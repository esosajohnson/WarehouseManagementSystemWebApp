@model WarehouseManagementSystem.Models.GoodsReceiptItem

@{
    ViewData["Title"] = "Goods Receipt Item Details";
}

<div class="container py-5">
    <div class="card shadow-sm border-0 rounded-4 p-4 mx-auto" style="max-width: 700px;">
        <h2 class="text-primary fw-semibold mb-4">@ViewData["Title"]</h2>
        
        <dl class="row">
            <dt class="col-sm-4">Quantity Received</dt>
            <dd class="col-sm-8">@Model.QuantityReceived</dd>

            <dt class="col-sm-4">Expiry Date</dt>
            <dd class="col-sm-8">@(Model.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-")</dd>

            <dt class="col-sm-4">Notes</dt>
            <dd class="col-sm-8">@Model.Notes</dd>

            <dt class="col-sm-4">Goods Receipt</dt>
            <dd class="col-sm-8">@Model.GoodsReceipt?.GoodsReceiptId</dd>

            <dt class="col-sm-4">Location</dt>
            <dd class="col-sm-8">@Model.Location?.Name</dd>

            <dt class="col-sm-4">Product</dt>
            <dd class="col-sm-8">@Model.Product?.Name</dd>
        </dl>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.GoodsReceiptItemId" class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left-circle me-1"></i> Back to List
            </a>
        </div>
    </div>
</div>
