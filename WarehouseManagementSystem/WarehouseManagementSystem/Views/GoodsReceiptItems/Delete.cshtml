@model WarehouseManagementSystem.Models.GoodsReceiptItem

@{
    ViewData["Title"] = "Delete Goods Receipt Item";
}

<div class="alert alert-danger mx-auto" role="alert" style="max-width: 700px;">
    <i class="bi bi-exclamation-triangle-fill me-2"></i>
    This action cannot be undone. Deleting this goods receipt item will permanently remove it from the system.
</div>

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4 p-4 mx-auto" style="max-width: 700px;">
        <h3 class="text-danger fw-bold mb-3">@ViewData["Title"]</h3>
        <h5 class="text-dark mb-4">Are you sure you want to delete this goods receipt item?</h5>

        <dl class="row">
            <dt class="col-sm-4">Quantity Received</dt>
            <dd class="col-sm-8">@Model.QuantityReceived</dd>

            <dt class="col-sm-4">Expiry Date</dt>
            <dd class="col-sm-8">@(Model.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-")</dd>

            <dt class="col-sm-4">Notes</dt>
            <dd class="col-sm-8">@Model.Notes</dd>

            <dt class="col-sm-4">Goods Receipt</dt>
            <dd class="col-sm-8">@Model.GoodsReceipt?.GoodsReceiptId</dd>

            <dt class="col-sm-4">Location</dt>
            <dd class="col-sm-8">@Model.Location?.Name</dd>

            <dt class="col-sm-4">Product</dt>
            <dd class="col-sm-8">@Model.Product?.Name</dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-4">
            <input type="hidden" asp-for="GoodsReceiptItemId" />
            <button type="submit" class="btn btn-danger me-2">
                <i class="bi bi-trash-fill me-1"></i> Delete
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle me-1"></i> Cancel
            </a>
        </form>
    </div>
</div>
