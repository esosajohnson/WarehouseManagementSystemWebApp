@model IEnumerable<WarehouseManagementSystem.Models.Supplier>

@{
    ViewData["Title"] = "Manage Suppliers";
}

@if (TempData["ErrorMessage"] != null) {
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="container">
    <div class="row pt-4 align-items-center">
        <div class="col">
            <h2 class="text-primary fw-semibold text-nowrap mb-3">@ViewData["Title"]</h2>
        </div>
        <div class="col-auto mb-2">
            <a asp-action="Create" class="btn btn-primary px-4 text-nowrap">
                <i class="bi bi-plus-circle me-1"></i> Create New Supplier
            </a>
        </div>
    </div>
</div>

<div class="container mb-2">
    <div class="row">
        <div class="col-12">
            <p>Here you can manage your suppliers. You can create, edit, or delete suppliers as needed.</p>
        </div>
    </div>
</div>

<div class="container px-1">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-truck display-1 text-muted"></i>
                    <h4 class="text-muted mt-3">No suppliers found.</h4>
                    <p class="text-muted">Click the button above to add your first supplier.</p>
                    <a asp-action="Create" class="btn btn-primary px-4 mt-3 text-nowrap">
                        <i class="bi bi-plus-circle me-1"></i> Create New Supplier
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var supplier in Model)
                        {
                            <tr>
                                <td>@supplier.Name</td>
                                <td>@supplier.Email</td>
                                <td>@supplier.Phone</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@supplier.SupplierId" class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@supplier.SupplierId" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-eye-fill"></i> Details
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@supplier.SupplierId" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash-fill"></i> Delete
                                        </a>
                                    </div>
                                   
                                </td>
                            </tr>
                        }
                    </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>