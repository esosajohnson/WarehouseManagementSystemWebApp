@model IEnumerable<WarehouseManagementSystem.Models.Location>

@if (TempData ["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@{
    ViewData["Title"] = "Warehouse Locations";
}

<div class="container">
    <div class="row pt-4 align-items-center">
        <div class="col">
            <h2 class="text-primary fw-semibold text-nowrap mb-3">@ViewData["Title"]</h2>
        </div>
        <div class="col-auto mb-2">
            <a asp-action="Create" class="btn btn-primary px-4 text-nowrap">
                <i class="bi bi-plus-circle me-1"></i> Add Location
            </a>
        </div>
    </div>
</div>

<div class="container mb-2">
    <div class="row">
        <div class="col-12">
            <p class="text-muted">Manage the locations within your warehouse. You can add, edit, view, or delete locations as needed.</p>
        </div>
    </div>
</div>

<div class="container px-1">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-geo-alt display-4 text-muted mb-3"></i>
                    <h4 class="text-muted">No locations found.</h4>
                    <p class="text-muted">Get started by adding a new location.</p>
                    <a asp-action="Create" class="btn btn-primary px-4">
                        <i class="bi bi-plus-circle me-1"></i> Add Location
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 25%">Name</th>
                            <th style="width: 20%">Aisle</th>
                            <th style="width: 20%">Shelf</th>
                            <th style="width: 35%">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model)
                        {
                            <tr>
                                <td>@entry.Name</td>
                                <td>@entry.Aisle</td>
                                <td>@entry.Shelf</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@entry.LocationId" class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@entry.LocationId" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-eye-fill"></i> Details
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@entry.LocationId" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash-fill"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
