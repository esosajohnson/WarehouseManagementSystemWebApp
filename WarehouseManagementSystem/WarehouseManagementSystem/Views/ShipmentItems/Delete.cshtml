@model WarehouseManagementSystem.Models.ShipmentItem

<div class="alert alert-danger mx-auto" role="alert" style="max-width: 700px;">
    <i class="bi bi-exclamation-triangle-fill me-2"></i>
    This action cannot be undone. Deleting this shipment item will permanently remove it from the system.
</div>
<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4 p-4 mx-auto" style="max-width: 700px;">
        <h3 class="text-danger fw-bold mb-3">Delete Shipment Item</h3>

        <h5 class="text-dark mb-4">Are you sure you want to delete this shipment item?</h5>
        <dl class="row">
            <dt class="col-sm-4">Shipment ID</dt>
            <dd class="col-sm-8">@Model.ShipmentId</dd>
            <dt class="col-sm-4">Product</dt>
            <dd class="col-sm-8">@Model.Product?.Name</dd>
            <dt class="col-sm-4">Location</dt>
            <dd class="col-sm-8">@Model.Location?.Name</dd>
            <dt class="col-sm-4">Quantity Shipped</dt>
            <dd class="col-sm-8">@Model.QuantityShipped</dd>
            <dt class="col-sm-4">Unit Price</dt>
            <dd class="col-sm-8">@(Model.UnitPrice?.ToString("C2") ?? "—")</dd>
            <dt class="col-sm-4">Line Total</dt>
            <dd class="col-sm-8">@(Model.LineTotal?.ToString("C2") ?? "—")</dd>
        </dl>

        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" asp-for="ShipmentItemId" />
            <button type="submit" class="btn btn-danger px-4">
                <i class="bi bi-trash me-1"></i> Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2 px-4">
                <i class="bi bi-arrow-left-circle me-1"></i> Back to List
            </a>
        </form>
    </div>
</div>
