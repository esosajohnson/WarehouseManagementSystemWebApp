@model WarehouseManagementSystem.Models.ShipmentItem

<div class="container py-5">
    <div class="card shadow-sm p-4 border-0 rounded-4 mx-auto" style="max-width: 800px;">
        <h2 class="text-primary fw-semibold mb-4">Shipment Item Details</h2>
        <dl class="row">
            <dt class="col-sm-4">Shipment ID</dt>
            <dd class="col-sm-8">@Model.ShipmentId</dd>
            <dt class="col-sm-4">Product ID</dt>
            <dd class="col-sm-8">@Model.ProductId</dd>
            <dt class="col-sm-4">Location ID</dt>
            <dd class="col-sm-8">@Model.LocationId</dd>
            <dt class="col-sm-4">Quantity Shipped</dt>
            <dd class="col-sm-8">@Model.QuantityShipped</dd>
            <dt class="col-sm-4">Unit Price</dt>
            <dd class="col-sm-8">@Model.UnitPrice?.ToString("C2") ?? "—"</dd>
            <dt class="col-sm-4">Line Total</dt>
            <dd class="col-sm-8">@Model.LineTotal?.ToString("C2") ?? "—"</dd>
        </dl>
        <div class="form-group">
            <a asp-action="Edit" asp-route-id="@Model?.ShipmentItemId" class="btn btn-primary px-4">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary ms-2 px-4">
                <i class="bi bi-arrow-left-circle me-1"></i> Back to List
            </a>
        </div>
    </div>
</div>