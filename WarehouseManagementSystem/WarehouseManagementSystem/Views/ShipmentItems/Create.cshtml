@model WarehouseManagementSystem.Models.ShipmentItem

@{
    ViewData["Title"] = "Add Shipment Item";
}

<div class="container py-5">
    <div class="card shadow-sm p-4 border-0 rounded-4 mx-auto" style="max-width: 800px;">
        <h2 class="text-primary fw-semibold mb-4">Add Shipment Item</h2>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="ShipmentId" class="form-label"></label>
                <select asp-for="ShipmentId" class="form-select" asp-items="ViewBag.ShipmentId">
                    <option value="">-- Select Shipment --</option>
                </select>
                <span asp-validation-for="ShipmentId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ProductId" class="form-label"></label>
                <select asp-for="ProductId" class="form-select" asp-items="ViewBag.ProductId">
                    <option value="">-- Select Product --</option>
                </select>
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="LocationId" class="form-label"></label>
                <select asp-for="LocationId" class="form-select" asp-items="ViewBag.LocationId">
                    <option value="">-- Select Location --</option>
                </select>
                <span asp-validation-for="LocationId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="QuantityShipped" class="form-label"></label>
                <input asp-for="QuantityShipped" class="form-control" />
                <span asp-validation-for="QuantityShipped" class="text-danger"></span>
            </div>
            
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Add Item
                </button>
                <button type="reset" class="btn btn-info"">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </a>
                <a asp-controller="Shipments" asp-action="Details" asp-route-id="@Model?.ShipmentId" class="btn btn-secondary ms-auto">
                    <i class="bi bi-arrow-left-circle me-1"></i> Back to Shipment Details
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}