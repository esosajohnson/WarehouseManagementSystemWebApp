@model IEnumerable<WarehouseManagementSystem.Models.Product>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@{
    ViewData["Title"] = "Manage Products";
}

<div class="container">
    <div class="row pt-4 align-items-center">
        <div class="col">
            <h2 class="text-primary fw-semibold text-nowrap mb-3">@ViewData["Title"]</h2>
        </div>
        <div class="col-auto mb-2">
            <a asp-action="Create" class="btn btn-primary px-4 text-nowrap">
                <i class="bi bi-plus-circle me-1"></i> Add New Product
            </a>
        </div>
    </div>
</div>

<div class="container mb-2">
    <div class="row">
        <div class="col-12">
            <p class="text-muted">Manage your products below. You can add, edit, view details, or delete products.</p>
        </div>
    </div>
</div>

<div class="container px-1 mb-3">
    <form method="get" asp-action="Index">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold small text-muted">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="searchString" value="@ViewData["SearchString"]"
                           class="form-control" placeholder="Search by name or SKU..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted">Category</label>
                <select name="categoryId" class="form-select" asp-items="@ViewData["CategoryId"] as SelectList">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted">Supplier</label>
                <select name="supplierId" class="form-select" asp-items="@ViewData["SupplierId"] as SelectList">
                    <option value="">All Suppliers</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </div>
    </form>
</div>

<div class="container px-1">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            @{ var q = ViewContext.HttpContext.Request.Query; var hasFilters = !string.IsNullOrEmpty((string?)ViewData["SearchString"]) || !string.IsNullOrEmpty((string)q["categoryId"]) || !string.IsNullOrEmpty((string)q["supplierId"]);}
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-box-seam display-1 text-muted"></i>
                    <h4 class="text-muted mt-3">No products found.</h4>
                    @if (hasFilters)
                    {
                        <p class="text-muted">No products match the current filters.</p>
                        <a asp-action="Index" class="btn btn-outline-secondary mt-3">Clear filters</a>
                    }
                    else
                    {
                        <p class="text-muted">Click the button above to add your first product.</p>
                        <a asp-action="Create" class="btn btn-primary px-4 mt-3">
                            <i class="bi bi-plus-circle me-1"></i> Add New Product
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock Quantity</th>
                            <th>Sku</th>
                            <th>Location</th>
                            <th>Supplier</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Category?.Name</td>
                                <td>@item.Price.ToString("C")</td>
                                <td>@item.Quantity</td>
                                <td>
                                    @if (item.Quantity < 10)
                                    {
                                        <span class="badge bg-danger">@item.Sku</span>
                                    }
                                    else if (item.Quantity < 20)
                                    {
                                        <span class="badge bg-warning text-dark">@item.Sku</span>
                                    }
                                    else
                                    {
                                        @item.Sku
                                    }
                                </td>
                                <td>@item.Location?.Name</td>
                                <td>@item.Supplier?.Name</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.ProductId"
                                               class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.ProductId"
                                               class="btn btn-outline-info btn-sm">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ProductId"
                                               class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>